# Copy to .env and adjust. Never commit .env.
BOOKSHELF_DB_PATH=data/bookshelf.db
BOOKSHELF_API_HOST=127.0.0.1
BOOKSHELF_API_PORT=8000

# Open Library (M2). Requests are cached in SQLite; the budget caps outbound calls per search.
BOOKSHELF_OPENLIBRARY_BASE_URL=https://openlibrary.org
BOOKSHELF_OPENLIBRARY_TIMEOUT_SECONDS=10
BOOKSHELF_OPENLIBRARY_CACHE_TTL_SECONDS=86400
BOOKSHELF_OPENLIBRARY_MAX_REQUESTS=3

# Local cross-encoder reranking (M3). The model downloads once, then runs on CPU.
BOOKSHELF_RERANK_ENABLED=true
BOOKSHELF_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
BOOKSHELF_RERANK_CANDIDATES=25

# LLM provider (M4). Both providers use the OpenAI chat-completions shape, so switching
# is one variable. These names are deliberately unprefixed to match the existing .env.
#   LLM_PROVIDER=ollama  -> local, private, needs `ollama serve` + the model pulled
#   LLM_PROVIDER=openai  -> hosted, needs OPENAI_API_KEY; your queries and library
#                           metadata (never review text) leave the machine
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Only used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=90
LLM_MAX_STEPS=4
LLM_TEMPERATURE=0.2
